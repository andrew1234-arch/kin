# ---------------------------------------------------------------- Kin Scan / Gate A / Replay (Base mainnet, read-only)
# Archive-capable Base mainnet RPC (eth_getCode at historical blocks, eth_getLogs).
# With HISTORY_PROVIDER=alchemy this must be an Alchemy Base endpoint (alchemy_getAssetTransfers).
BASE_RPC_URL=
# alchemy | blockscout | rpc-scan (local anvil only)
HISTORY_PROVIDER=alchemy
# Only for HISTORY_PROVIDER=blockscout: the Base Blockscout instance's REST API root, ending in /api/v2
BLOCKSCOUT_API_URL=
RPC_CONCURRENCY=8
EARLY_BUYERS=50
FUNDING_WINDOW_HOURS=72
LOGS_CHUNK=2000
MAX_SCAN_BLOCKS=43200
FRESH_MAX_NONCE=0
# Counterfactual caps (product parameters, printed with every result)
KIN_CAP_ETH=0.1
KIN_FRESH_POOL_CAP_ETH=0.2
# Optional: JSON file {"source": "<pricing page URL + date>", "perCallUsd": {"<method>": <usd>}}
GATE_A_PRICING=
# Optional: extra addresses to treat like exchanges (comma-separated)
EXTRA_EXCLUSIONS=

# ---------------------------------------------------------------- API server
PORT=8787
# The web origin allowed to call the API (e.g. the Vercel URL); * while testing
CORS_ORIGIN=*
# Where launch state, sandbox runs, scan cache and replay reports are stored
DATA_DIR=
SCAN_CACHE_SECONDS=600

# ---------------------------------------------------------------- Launches (Base Sepolia)
LAUNCH_RPC_URL=
LAUNCH_CHAIN_ID=84532
# Transfer-history provider for the launch chain (alchemy | blockscout); used when building allowlists.
# With alchemy, LAUNCH_RPC_URL must be an Alchemy Base Sepolia endpoint.
LAUNCH_HISTORY_PROVIDER=alchemy
# Only for LAUNCH_HISTORY_PROVIDER=blockscout: the Base SEPOLIA Blockscout REST API root, ending in /api/v2
# (BLOCKSCOUT_API_URL above is Base mainnet's and is never used for launches)
LAUNCH_BLOCKSCOUT_API_URL=
# Admin CLI only (src/launch/admin.ts): launcher key and deployment file
LAUNCH_ADMIN_KEY=
LAUNCH_DEPLOYMENT=../contracts/deployments/84532.json

# ---------------------------------------------------------------- Attack sandbox (Base Sepolia)
SANDBOX_RPC_URL=
# A dedicated, throwaway key holding Base Sepolia ETH. Never a personal wallet.
SANDBOX_RELAYER_KEY=
SANDBOX_DEPLOYMENT=../contracts/deployments/84532.json
# Block explorer base URL for transaction links (optional)
SANDBOX_EXPLORER_URL=
SANDBOX_BUNDLE_SIZE=20
SANDBOX_PER_WALLET_ETH=0.0001
SANDBOX_CAP_BUYS=10
SANDBOX_WINDOW_DELAY_SEC=8
SANDBOX_WINDOW_SEC=600
SANDBOX_LOCK_SEC=300
SANDBOX_MAX_RUNS_PER_DAY=40
SANDBOX_IP_COOLDOWN_SECONDS=120
