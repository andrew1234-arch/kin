# Base Sepolia RPC endpoint. Take it from Base's official docs or your provider dashboard; nothing is hardcoded.
BASE_SEPOLIA_RPC_URL=
# Base mainnet RPC endpoint (P2 fallback deploy only).
BASE_RPC_URL=
# Deployer key (fund it with Base Sepolia ETH first). Never commit a real key.
DEPLOYER_PRIVATE_KEY=
# Gate B knobs (optional)
GATE_B_DELAY_SECONDS=90
GATE_B_CAP_WEI=1000000000000000
