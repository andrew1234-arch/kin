# Kin engine API (engine/src/server.ts), e.g. https://<your-worker-host>
NEXT_PUBLIC_KIN_API=
# Launch chain: Base Sepolia is 84532 (source: Uniswap v4 deployments page, "Base Sepolia: 84532")
NEXT_PUBLIC_CHAIN_ID=84532
# Launch chain RPC, from Base's docs or your provider. Nothing is hardcoded.
NEXT_PUBLIC_RPC_URL=
# Block explorer base URL for the launch chain (no trailing slash), for transaction links
NEXT_PUBLIC_EXPLORER_URL=
# Block explorer base URL for Base mainnet, for Kin Scan links
NEXT_PUBLIC_SCAN_EXPLORER_URL=
# The contents of contracts/deployments/<chainId>.json (one line)
NEXT_PUBLIC_DEPLOYMENT_JSON=
# Base URL of the published launch copies (engine `admin.ts publish` writes DATA_DIR/publish/<slug>.json; host them
# on IPFS or any static host). The launch page falls back to them when the engine API is unreachable. Optional.
NEXT_PUBLIC_LAUNCH_MIRROR=
# Slippage tolerance for window buys, in basis points of the quoted output (default 300 = 3%)
NEXT_PUBLIC_SLIPPAGE_BPS=
